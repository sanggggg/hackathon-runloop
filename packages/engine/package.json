{
  "name": "@branchpoint/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "branchpoint-engine": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test dist/test/*.test.js && python3 -m unittest discover -s runner -p 'test_*.py'",
    "smoke:runloop": "pnpm run build && node scripts/smoke-runloop.mjs",
    "e2e:live-demo": "pnpm run build && node scripts/live-demo-e2e.mjs"
  },
  "dependencies": {
    "@branchpoint/schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  }
}
