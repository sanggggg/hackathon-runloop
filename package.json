{
  "name": "branchpoint",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "build:cli": "pnpm --filter @branchpoint/cli... build",
