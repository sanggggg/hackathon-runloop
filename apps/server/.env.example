# Required to execute QA runs. The server can boot without it, but /readyz and
# POST /runs return 503 until it is configured.
RUNLOOP_API_KEY=

# Required on Railway / NODE_ENV=production. Use a long random value.
BRANCHPOINT_API_TOKEN=

# Local persistence. Railway overrides this with /app/data.
BRANCHPOINT_DATA_DIR=.branchpoint-data

# Browser dashboard origins allowed to call this API directly.
BRANCHPOINT_CORS_ORIGINS=http://localhost:3000

# One QA run at a time; each run may use up to eight Runloop Devboxes.
BRANCHPOINT_MAX_ACTIVE_RUNS=1
BRANCHPOINT_MAX_CONCURRENCY=8
BRANCHPOINT_SHUTDOWN_TIMEOUT_MS=170000

# Optional structured model mode. Set both; the second value is the NAME of an
# existing Runloop Secret, not a raw OpenRouter API key.
# BRANCHPOINT_OPENROUTER_MODEL=google/gemini-3.1-flash-lite
# BRANCHPOINT_OPENROUTER_SECRET=MY_OPENROUTER_SECRET
