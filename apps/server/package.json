{
  "name": "@branchpoint/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "pnpm --filter @branchpoint/engine build && node --env-file-if-exists=.env --watch --experimental-strip-types src/index.ts",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @branchpoint/engine build && pnpm run build && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@branchpoint/engine": "workspace:*",
    "@branchpoint/schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  }
}
